<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List: the default screen on desktop. One badge status column, one toggle for on/off. -->
    <record id="pan_probe_agent_view_list" model="ir.ui.view">
        <field name="name">pan.probe.agent.list</field>
        <field name="model">pan.probe.agent</field>
        <field name="arch" type="xml">
            <list sample="1" decoration-muted="not active">
                <field name="name"/>
                <field name="app"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'running'"
                       decoration-warning="state == 'needs_key'"
                       decoration-danger="state == 'failing'"
                       decoration-muted="state == 'off'"/>
                <field name="last_run"/>
                <field name="user_id" widget="many2one_avatar_user" optional="hide"/>
                <field name="run_count" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Kanban: the phone opens this first. Name, app, status; the switch turns it off. -->
    <record id="pan_probe_agent_view_kanban" model="ir.ui.view">
        <field name="name">pan.probe.agent.kanban</field>
        <field name="model">pan.probe.agent</field>
        <field name="arch" type="xml">
            <kanban sample="1" quick_create="false">
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <field name="app" class="text-muted"/>
                        <footer>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'running'"
                                   decoration-warning="state == 'needs_key'"
                                   decoration-danger="state == 'failing'"
                                   decoration-muted="state == 'off'"/>
                            <field name="active" widget="boolean_toggle" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form: Overview page type. Run Now first in the header (the only button a phone shows). -->
    <record id="pan_probe_agent_view_form" model="ir.ui.view">
        <field name="name">pan.probe.agent.form</field>
        <field name="model">pan.probe.agent</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_run" type="object" string="Run Now" class="btn-primary"
                            invisible="not id or state in ('needs_key', 'off')"/>
                    <button name="action_open_test" type="object" string="Test"
                            invisible="not id or app != 'sale' or state == 'off'"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'running'"
                           decoration-warning="state == 'needs_key'"
                           decoration-danger="state == 'failing'"
                           decoration-muted="state == 'off'"/>
                </header>
                <div class="alert alert-danger mb-0" role="alert" invisible="state != 'failing' or not error">
                    <field name="error"/>
                </div>
                <div class="alert alert-warning mb-0" role="alert" invisible="state != 'needs_key'">
                    No Key yet. Add one in Settings.
                </div>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Quote Follow-up"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="app"/>
                            <field name="user_id" widget="many2one_avatar_user"
                                   context="{'active_test': True}"/>
                        </group>
                        <group>
                            <field name="last_run"/>
                            <field name="run_count"/>
                        </group>
                    </group>
                    <group>
                        <field name="instructions" placeholder="e.g. Draft a follow-up for quotations older than a week."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="pan_probe_agent_view_search" model="ir.ui.view">
        <field name="name">pan.probe.agent.search</field>
        <field name="model">pan.probe.agent</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
                <filter name="failing" string="Failing" domain="[('state', '=', 'failing')]"/>
                <filter name="needs_key" string="Needs Key" domain="[('state', '=', 'needs_key')]"/>
                <separator/>
                <filter name="on" string="On" domain="[('active', '=', True)]"/>
                <filter name="off" string="Off" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="by_app" string="App" context="{'group_by': 'app'}"/>
                    <filter name="by_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pan_probe_agent" model="ir.actions.act_window">
        <field name="name">Agents</field>
        <field name="res_model">pan.probe.agent</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="mobile_view_mode">kanban</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first agent</p>
        </field>
    </record>
</odoo>
