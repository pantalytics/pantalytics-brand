<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 6 agents: every status at least once, one failing with an error. -->
    <record id="agent_sales" model="pan.probe.agent">
        <field name="name">Sales Agent</field>
        <field name="app">sale</field>
        <field name="state">running</field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="instructions">Draft a follow-up for quotations older than a week.</field>
        <field name="last_run" eval="(DateTime.now() - relativedelta(hours=2)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="run_count">42</field>
    </record>
    <record id="agent_crm" model="pan.probe.agent">
        <field name="name">Lead Scorer</field>
        <field name="app">crm</field>
        <field name="state">failing</field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="instructions">Score new leads from 1 to 5.</field>
        <field name="last_run" eval="(DateTime.now() - relativedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="run_count">17</field>
        <field name="error">The Key was refused. Add a new Key in Settings.</field>
    </record>
    <record id="agent_inventory" model="pan.probe.agent">
        <field name="name">Stock Checker</field>
        <field name="app">stock</field>
        <field name="state">running</field>
        <field name="user_id" ref="base.user_demo"/>
        <field name="instructions">Flag products below their reorder point.</field>
        <field name="last_run" eval="(DateTime.now() - relativedelta(minutes=30)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="run_count">128</field>
    </record>
    <record id="agent_followup" model="pan.probe.agent">
        <field name="name">Lead Follow-up</field>
        <field name="app">crm</field>
        <field name="state">needs_key</field>
        <field name="user_id" ref="base.user_demo"/>
    </record>
    <record id="agent_counter" model="pan.probe.agent">
        <field name="name">Stock Counter</field>
        <field name="app">stock</field>
        <field name="enabled" eval="False"/>
        <field name="state">off</field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="last_run" eval="(DateTime.now() - relativedelta(days=12)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="run_count">9</field>
    </record>
    <record id="agent_delivery" model="pan.probe.agent">
        <field name="name">Delivery Tracker</field>
        <field name="app">stock</field>
        <field name="state">running</field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="last_run" eval="(DateTime.now() - relativedelta(hours=5)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="run_count">63</field>
    </record>
</odoo>
