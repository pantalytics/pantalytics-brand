<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pan_ui_probe.DrillRows">
        <div class="o_drill_rows">
            <t t-foreach="this.groups" t-as="group" t-key="group.key">
                <!-- Advanced: folded with Odoo's caret, open by itself when a row in it waits -->
                <button t-if="group.key === 'advanced'" type="button"
                        class="btn btn-link text-body fw-bold p-0 mt-3 mb-2 d-flex align-items-center gap-1 o_drill_advanced"
                        t-att-aria-expanded="this.advancedOpen ? 'true' : 'false'"
                        t-on-click="() => this.toggleAdvanced()">
                    <i t-if="this.material" class="oi oi-fw" t-att-data-icon="this.advancedOpen ? 'arrow_drop_down' : 'arrow_right'" aria-hidden="true"/>
                    <i t-else="" t-attf-class="fa fa-fw {{ this.advancedOpen ? 'fa-caret-down' : 'fa-caret-right' }}" aria-hidden="true"/>
                    <span>Advanced</span>
                    <span t-if="this.advancedCount" class="badge rounded-pill text-bg-danger ms-1" t-esc="this.advancedCount"/>
                </button>
                <div t-if="group.key === 'main' or this.advancedOpen" class="list-group" role="list">
                    <t t-foreach="group.rows" t-as="row" t-key="row.key">
                        <!-- Toggle: on/off in the row, saved at once -->
                        <label t-if="row.control === 'toggle'" role="listitem"
                               class="list-group-item d-flex align-items-center gap-3 mb-0"
                               t-att-class="{ 'text-muted': row.disabled }"
                               t-att-data-tooltip="row.disabled ? row.reason : undefined">
                            <span class="flex-grow-1 text-truncate" t-esc="row.label"/>
                            <span t-if="row.disabled" class="text-muted" t-esc="row.reason"/>
                            <span class="form-check form-switch mb-0">
                                <input type="checkbox" role="switch" class="form-check-input"
                                       t-att-checked="this.current(row)" t-att-disabled="row.disabled"
                                       t-on-change="(ev) => this.set(row, ev.target.checked)"/>
                            </span>
                        </label>
                        <!-- Pop-up menu: a choice among 2-5, a check at the chosen one -->
                        <t t-elif="row.control === 'select'">
                            <div t-if="row.disabled" role="listitem"
                                 class="list-group-item d-flex align-items-center gap-3 text-muted"
                                 t-att-data-tooltip="row.reason">
                                <span class="flex-grow-1 text-truncate" t-esc="row.label"/>
                                <span t-esc="row.reason"/>
                            </div>
                            <Dropdown t-else="" position="'bottom-end'">
                                <button type="button" role="listitem"
                                        class="list-group-item list-group-item-action d-flex align-items-center gap-3">
                                    <span class="flex-grow-1 text-truncate text-start" t-esc="row.label"/>
                                    <span class="text-muted" t-esc="this.chosenLabel(row)"/>
                                    <i t-if="this.material" class="oi text-muted" data-icon="expand_more" aria-hidden="true"/>
                                    <i t-else="" class="fa fa-chevron-down text-muted" aria-hidden="true"/>
                                </button>
                                <t t-set-slot="content">
                                    <DropdownItem t-foreach="row.options" t-as="option" t-key="option[0]"
                                                  onSelected="() => this.set(row, option[0])">
                                        <span class="d-flex align-items-center gap-2">
                                            <span class="flex-grow-1" t-esc="option[1]"/>
                                            <t t-if="option[0] === this.current(row)">
                                                <i t-if="this.material" class="oi" data-icon="check" aria-hidden="true"/>
                                                <i t-else="" class="fa fa-check" aria-hidden="true"/>
                                            </t>
                                        </span>
                                    </DropdownItem>
                                </t>
                            </Dropdown>
                        </t>
                        <!-- Level: the whole row opens the next page -->
                        <button t-else="" type="button" role="listitem"
                                class="list-group-item list-group-item-action d-flex align-items-center gap-3"
                                t-att-class="{ 'text-muted': row.disabled }"
                                t-att-disabled="row.disabled"
                                t-att-data-tooltip="row.disabled ? row.reason : undefined"
                                t-on-click="() => this.open(row)">
                            <span class="flex-grow-1 text-truncate text-start" t-esc="row.label"/>
                            <span t-att-class="row.tone === 'danger' and !row.disabled ? 'text-danger' : 'text-muted'"
                                  t-esc="row.disabled ? row.reason : row.value"/>
                            <span t-if="row.count and !row.disabled" class="badge rounded-pill text-bg-danger" t-esc="row.count"/>
                            <t t-if="!row.disabled">
                                <!-- 20: Material Symbols; 18 and 19: Font Awesome -->
                                <i t-if="this.material" class="oi text-muted" t-att-data-icon="row.external ? 'open_in_new' : 'chevron_forward'" aria-hidden="true"/>
                                <i t-else="" t-attf-class="fa {{ row.external ? 'fa-external-link' : 'fa-chevron-right' }} text-muted" aria-hidden="true"/>
                            </t>
                        </button>
                    </t>
                </div>
            </t>
        </div>
    </t>
</templates>
