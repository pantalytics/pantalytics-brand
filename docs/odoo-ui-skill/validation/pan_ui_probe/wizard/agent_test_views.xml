<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Test an agent on this quotation: opened from the quotation's action menu,
         where the task starts. Once the answer is there, the only button left is Done. -->
    <record id="pan_probe_agent_test_view_form" model="ir.ui.view">
        <field name="name">pan.probe.agent.test.form</field>
        <field name="model">pan.probe.agent.test</field>
        <field name="arch" type="xml">
            <form>
                <group invisible="answer">
                    <field name="agent_count" invisible="1"/>
                    <!-- one choice is no choice: the field only shows when there are two or more -->
                    <field name="agent_id" options="{'no_create': True, 'no_open': True}"
                           invisible="agent_count &lt; 2"/>
                    <field name="order_id" invisible="1"/>
                </group>
                <group invisible="not answer">
                    <field name="answer" nolabel="1" colspan="2"/>
                </group>
                <footer>
                    <button name="action_test" type="object" string="Test" class="btn-primary"
                            data-hotkey="q" invisible="answer"/>
                    <button special="cancel" string="Discard" class="btn-secondary" invisible="answer"/>
                    <button special="cancel" string="Done" class="btn-primary" invisible="not answer"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pan_probe_agent_test" model="ir.actions.act_window">
        <field name="name">Test Agent</field>
        <field name="res_model">pan.probe.agent.test</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'dialog_size': 'medium'}</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">form</field>
    </record>
</odoo>
