<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pan_probe_agent_test_view_form" model="ir.ui.view">
        <field name="name">pan.probe.agent.test.form</field>
        <field name="model">pan.probe.agent.test</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="agent_id" invisible="1"/>
                    <field name="order_id" options="{'no_create': True}"/>
                    <field name="answer" invisible="not answer"/>
                </group>
                <footer>
                    <button name="action_test" type="object" string="Run Test" class="btn-primary" data-hotkey="q"/>
                    <button special="cancel" string="Discard" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pan_probe_agent_test" model="ir.actions.act_window">
        <field name="name">Test Agent</field>
        <field name="res_model">pan.probe.agent.test</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'dialog_size': 'medium'}</field>
    </record>
</odoo>
