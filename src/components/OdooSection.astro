---
// One annotated screenshot section of the Odoo UI page: shots, numbered
// legend, our rule. label: "Ours" for Odoo's screens, "Deviation" for ours.
import type { Locale } from "@/i18n/config";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang: Locale;
  s: { key: string; count: number; images: string[]; phones?: string[]; phone?: boolean };
  size: Record<string, [number, number]>;
  label: string;
  sub?: boolean;
}
const { lang, s, size, label, sub } = Astro.props;
const H = sub ? "h3" : "h2";
const t = useTranslations(lang);
const range = (n: number) => Array.from({ length: n }, (_, i) => i + 1);
const img = (name: string) => `/images/odoo-ui/${name}.jpg`;
---

  <section class="odoo-section" id={s.key}>
    <H>{t(`odoo.${s.key}.title`)}</H>
    <p>{t(`odoo.${s.key}.desc`)}</p>
    <div class:list={["odoo-shots", { phone: s.phone }]}>
      {s.images.map((name) => (
        <a href={img(name)} class="odoo-shot">
          <img
            src={img(name)}
            alt={t(`odoo.${s.key}.title`)}
            width={size[name][0]}
            height={size[name][1]}
            loading="lazy"
            decoding="async"
          />
        </a>
      ))}
    </div>
    {s.phones && (
      <div class="odoo-shots phone">
        {s.phones.map((name) => (
          <a href={img(name)} class="odoo-shot">
            <img src={img(name)} alt={t(`odoo.${s.key}.title`)} width={size[name][0]}
                 height={size[name][1]} loading="lazy" decoding="async" />
          </a>
        ))}
      </div>
    )}
    <ol class="odoo-legend">
      {range(s.count).map((i) => (
        <li>
          <strong>{t(`odoo.${s.key}.${i}.name`)}</strong>
          <span>{t(`odoo.${s.key}.${i}.desc`)}</span>
        </li>
      ))}
    </ol>
    <p class="odoo-rule"><strong>{label}</strong> {t(`odoo.${s.key}.rule`)}</p>
  </section>

