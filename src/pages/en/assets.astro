---
import BrandLayout from "@/layouts/BrandLayout.astro";
import { useTranslations } from "@/i18n/utils";

const t = useTranslations("en");

const P = "Abstract on heavy cream watercolor paper with beautiful visible texture, navy (#1b3a5c) ink lines and soft purple (#9b99ff) watercolor blooms, wabi-sabi imperfection, fine art print quality, no objects no figures no text no letters";

const assets = [
  { file: "01-hero-converging.png", title: "Website hero", size: "1440 × 810", type: "Converging lines", prompt: `${P}, two thin ink lines one navy one lighter purple curving gently toward each other meeting in a soft watercolor bloom at center right, vast empty paper space on left for text overlay, landscape format` },
  { file: "02-footer-line.png", title: "Footer", size: "1440 × 400", type: "Line + bloom", prompt: `${P}, single thin navy ink line drawing a long gentle curve from left to right across lower third of page, tiny purple watercolor bloom where line ends, vast empty cream paper above, subtle and quiet, landscape format` },
  { file: "03-about-duo.png", title: "About hero", size: "1440 × 810", type: "Converging lines + gold", prompt: `${P}, two thin navy ink lines approaching from opposite sides of the page meeting in a warm purple and gold (#e8a317) watercolor bloom in the center, suggesting partnership and collaboration, vast textured paper space, landscape format` },
  { file: "04-404-broken.png", title: "404 page", size: "1280 × 1280", type: "Broken line", prompt: `${P}, single thin navy ink line starting confidently from left then stopping abruptly in the middle of the page, small confused purple watercolor splash where it ends, vast empty cream paper around it, a gentle visual joke, square format` },
  { file: "05-blog-parallel.png", title: "Blog hero — flow", size: "1920 × 1080", type: "Parallel lines", prompt: `${P}, three thin parallel navy ink lines flowing gently across the page with slight waves, one line ends in a soft purple watercolor bloom, the other two fade into paper grain, vast cream space above for title text, landscape format` },
  { file: "06-blog-tech.png", title: "Blog hero — tech", size: "1920 × 1080", type: "Line + blueprint grid", prompt: `${P}, single ascending navy ink line with faint geometric grid pattern barely visible underneath like ghost of graph paper, purple watercolor bloom at the peak, technical yet poetic, vast cream paper space, landscape format` },
  { file: "07-blog-growth.png", title: "Blog hero — growth", size: "1920 × 1080", type: "Data points", prompt: `${P}, thin navy ink line gently ascending from bottom left to upper right, four small purple watercolor blooms at intervals along the line like data points on a growth chart, each bloom slightly larger than the last, vast empty textured cream paper, elegant and optimistic, landscape format` },
  { file: "08-linkedin-network.png", title: "LinkedIn post", size: "1200 × 1200", type: "Network constellation", prompt: `${P}, delicate navy ink dots connected by hairline lines forming a loose network constellation on rough handmade paper, soft purple watercolor halos around three key nodes, visible paper texture and fibers, like a star map painted by hand, generous empty space in upper half for text, square format` },
  { file: "09-linkedin-banner.png", title: "LinkedIn banner", size: "1584 × 396", type: "Line + bloom", prompt: `${P}, single thin navy ink line flowing gently from left across the page, ending in a soft purple bloom on the right third, very wide and narrow format, vast empty cream paper, subtle and elegant` },
  { file: "10-og-datapoints.png", title: "OG image", size: "1200 × 630", type: "Data points", prompt: `${P}, thin navy ink line ascending gently from lower left to upper right, three small purple watercolor blooms as data points along the line, each slightly different size, vast empty textured cream paper with space on right for text, landscape format` },
  { file: "11-youtube-thumb.png", title: "YouTube thumbnail", size: "1280 × 720", type: "Bold bloom", prompt: `${P}, bold purple watercolor bloom in the left third with navy ink lines radiating outward from it like a data burst, slightly more saturated than usual, vast cream paper on right two thirds for text, impactful yet elegant, landscape format` },
  { file: "12-video-intro.png", title: "Video intro still", size: "1920 × 1080", type: "Central bloom", prompt: `${P}, single soft purple watercolor bloom exactly in the center of the page, three thin navy ink lines extending outward from it in different directions like compass points, vast cream paper around it, centered and balanced, cinematic landscape format` },
  { file: "13-texture-wash.png", title: "Texture — wash", size: "1440 × 1440", type: "Pure watercolor", prompt: `${P}, soft purple and navy watercolor washes flowing organically in one corner, beautiful ink diffusion edges where colors meet paper, 70 percent empty cream paper, pure texture with no lines, minimal and meditative, square format` },
  { file: "14-texture-blueprint.png", title: "Texture — blueprint", size: "1440 × 1440", type: "Blueprint + watercolor", prompt: `${P}, soft purple watercolor wash with precise navy geometric blueprint lines drawn through it, technical grid pattern fading into organic ink diffusion, where engineering meets art, visible paper fiber texture, torn edge at bottom, square format` },
  { file: "14b-blueprint-corner.png", title: "Blueprint — corner", size: "1440 × 1440", type: "Blueprint + watercolor", prompt: `${P}, soft purple watercolor wash concentrated in upper left corner with precise navy geometric blueprint grid lines showing through the wash, lines extend beyond the watercolor into bare paper, torn deckled edge visible, 60 percent empty cream paper, square format` },
  { file: "14c-blueprint-wide.png", title: "Blueprint — wide", size: "1920 × 1080", type: "Blueprint + watercolor", prompt: `${P}, soft purple watercolor wash spreading from left side with precise navy blueprint grid lines and geometric technical drawing visible through the wash, lines fade into bare textured paper on the right, torn paper edge at bottom, generous cream space on right for text, landscape format` },
  { file: "14d-blueprint-fractal.png", title: "Blueprint — fractal", size: "1440 × 1440", type: "Fractal + watercolor", prompt: `${P}, rich purple watercolor blooms with navy blueprint technical lines creating fractal-like geometric patterns through the wash, architectural precision dissolving into organic ink diffusion, multiple bloom clusters connected by hairline grid, visible paper fiber texture, torn edge, square format` },
  { file: "14e-blueprint-subtle.png", title: "Blueprint — subtle", size: "1200 × 1200", type: "Subtle blueprint", prompt: `${P}, very subtle purple watercolor wash in lower right with faint navy blueprint grid lines barely visible underneath, most of the page is beautiful empty cream textured paper, extremely minimal, the blueprint is almost a ghost, quiet and sophisticated, square format` },
  { file: "15-story-vertical.png", title: "Story / mobile", size: "1080 × 1920", type: "Vertical line + gold", prompt: `${P}, single thin navy ink line dropping vertically with a gentle wave, ending in a soft purple watercolor bloom near the bottom, tiny gold (#e8a317) accent dot along the line, vast empty textured paper above, tall portrait format` },
  { file: "16-video-paper.png", title: "Video — paper", size: "2048 × 1152", type: "Empty background", prompt: "Empty sheet of heavy cream Japanese washi rice paper filling the whole frame, visible long paper fibers and fine grain, very faint torn deckle edge along the bottom, soft even daylight, wabi-sabi imperfection, fine art print quality, 95% empty, no objects no figures no text no letters" },
  { file: "17-video-title-card.png", title: "Video — title card", size: "2048 × 1152", type: "Line + bloom", prompt: `${P}, a single thin navy ink line enters from the left edge and stops at one third of the width, a small soft purple watercolor bloom with irregular edges where it ends, right two thirds of the paper completely empty` },
  { file: "18-video-frame.png", title: "Video — screen recording frame", size: "2048 × 1152", type: "Brush frame", prompt: `${P}, four short, slightly dry navy ink brush strokes suggesting the corners of a large rectangle in the center of the sheet, the inside of the rectangle completely empty paper, one tiny soft purple watercolor bloom near the top-right corner stroke` },
  { file: "19-video-outro.png", title: "Video — outro", size: "2048 × 1152", type: "Line through bloom", prompt: `${P}, two thin navy ink lines with gentle curves come in from the left and right edges and converge into one soft purple watercolor bloom slightly right of center, ink bleeding a little into the paper, lots of empty paper` },
  { file: "20-bloom-single.png", title: "Single bloom", size: "1024 × 1024", type: "Animation element", prompt: "A single irregular soft purple (#9b99ff) watercolor bloom, centered, pigment pooling darker at the edges, on plain flat cream watercolor paper, nothing else, wabi-sabi imperfection, fine art print quality, no objects no figures no text no letters" },
];

const videos = [
  { file: "01-title-card-ink.mp4", title: "Title card — ink appears", prompt: "Locked-off top-down shot of a sheet of cream watercolor paper, camera completely still. After a moment of stillness, a thin navy ink line slowly draws itself from the left edge toward the center, as if pulled by an invisible brush, ink soaking into the paper fibers. Where the line stops, a soft purple watercolor bloom gently blossoms outward with irregular wet edges, then settles. Calm, slow, meditative pace, Japanese wabi-sabi feel. No hands, no brush, no objects, no text." },
  { file: "02-frame-ink.mp4", title: "Frame — brush strokes", prompt: "Locked-off top-down shot of a sheet of cream handmade paper with torn edges, camera completely still. One by one, four dry navy ink brush strokes appear at the corners of an invisible rectangle, each stroke painted on quickly with a dry-brush texture, a short pause between strokes. Finally a small purple watercolor bloom soaks into the paper near the top-right corner. Calm, deliberate, Japanese calligraphy rhythm. No hands, no brush, no objects, no text." },
  { file: "03-outro-ink.mp4", title: "Outro — bloom and line", prompt: "Locked-off top-down shot of a sheet of cream handmade paper with torn edges, camera completely still. A soft purple watercolor bloom slowly spreads outward from a point slightly right of center, wet pigment creeping through the paper fibers. Then a thin navy ink line glides across the sheet from left to right, passing through the bloom, ink bleeding slightly where it touches the wet paint. Everything settles into stillness. Slow, meditative, Japanese wabi-sabi pace. No hands, no brush, no objects, no text." },
];
---

<BrandLayout title="Assets — Pantalytics" lang="en" description="All brand visuals with corresponding Flux prompts." activeSection="assets">
  <h1>Assets</h1>
  <p class="brand-intro">All generated brand visuals in the minimal line + wash style. Click a prompt to copy.</p>

  <div class="assets-grid">
    {assets.map((a) => (
      <div class="asset-card">
        <div class="asset-image">
          <img src={`/images/brand-assets/${a.file}`} alt={a.title} loading="lazy" />
        </div>
        <div class="asset-info">
          <h4>{a.title}</h4>
          <div class="asset-meta">{a.size} · {a.type}</div>
          <details class="asset-prompt">
            <summary>Prompt</summary>
            <pre><code>{a.prompt}</code></pre>
          </details>
        </div>
      </div>
    ))}
  </div>
  <h2>Video</h2>
  <p class="brand-intro">Flux 3 Video, image-to-video with two keyframes: start = the same sheet empty (the still edited with <em>Remove all ink and purple paint, keep the paper exactly identical</em>), end = the still above. 6 seconds, no audio. Use as inspiration and as intro/outro in the marketing videos.</p>
  <div class="assets-grid">
    {videos.map((v) => (
      <div class="asset-card">
        <div class="asset-image">
          <video src={`/videos/brand-assets/${v.file}`} autoplay muted loop playsinline preload="metadata"></video>
        </div>
        <div class="asset-info">
          <h4>{v.title}</h4>
          <div class="asset-meta">1280 × 704 · 6s</div>
          <details class="asset-prompt">
            <summary>Prompt</summary>
            <pre><code>{v.prompt}</code></pre>
          </details>
        </div>
      </div>
    ))}
  </div>
</BrandLayout>

<style>
  .assets-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-sm);
    margin-block: var(--space-md);
  }

  .asset-card {
    border: 1px solid var(--color-border-primary);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--color-bg-secondary);
  }

  .asset-image {
    background-color: #f5f0ea;
    padding: var(--space-xs);
  }

  .asset-image img,
  .asset-image video {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .asset-info {
    padding: var(--space-sm);
  }

  .asset-info h4 {
    font-size: 0.88rem;
    margin-bottom: 0.25rem;
  }

  .asset-meta {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    font-family: monospace;
    margin-bottom: var(--space-xs);
  }

  .asset-prompt {
    margin-top: var(--space-xs);
  }

  .asset-prompt summary {
    font-size: 0.75rem;
    color: var(--color-accent);
    cursor: pointer;
    font-weight: var(--font-weight-medium);
  }

  .asset-prompt pre {
    margin-top: var(--space-xs);
    padding: var(--space-xs);
    background-color: var(--color-bg-primary);
    border-radius: var(--radius-sm);
    overflow-x: auto;
  }

  .asset-prompt code {
    font-size: 0.69rem;
    color: var(--color-text-secondary);
    white-space: pre-wrap;
    word-break: break-word;
    line-height: 1.5;
  }

  @media (max-width: 767px) {
    .assets-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
