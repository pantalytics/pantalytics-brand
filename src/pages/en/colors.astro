---
import BrandLayout from "@/layouts/BrandLayout.astro";
import { useTranslations } from "@/i18n/utils";

const t = useTranslations("en");
---

<BrandLayout title={t("colors.title")} lang="en" description={t("colors.intro")} activeSection="colors">
  <h1>{t("colors.h1")}</h1>
  <p class="brand-intro">{t("colors.intro")}</p>

  <h2>{t("colors.logo.title")}</h2>
  <p>{t("colors.logo.desc")}</p>
  <div class="swatch-grid">
    <div class="swatch">
      <div class="swatch-color" style="background-color: #1b3a5c;">
        <span style="color: #fff; font-size: 0.75rem; font-weight: 500;">Aa</span>
      </div>
      <div class="swatch-info">
        <div class="swatch-name">Navy Blue</div>
        <div class="swatch-value">#1b3a5c · rgb(27, 58, 92)</div>
        <div class="swatch-token">Logo text & icon</div>
      </div>
    </div>
    <div class="swatch">
      <div class="swatch-color" style="background-color: #e8a317;">
        <span style="color: #fff; font-size: 0.75rem; font-weight: 500;">Aa</span>
      </div>
      <div class="swatch-info">
        <div class="swatch-name">Gold</div>
        <div class="swatch-value">#e8a317 · rgb(232, 163, 23)</div>
        <div class="swatch-token">Logo accent & tagline</div>
      </div>
    </div>
  </div>

  <h2>{t("colors.primary.title")}</h2>
  <div class="swatch-grid">
    <div class="swatch">
      <div class="swatch-color" style="background-color: #9b99ff;">
        <span style="color: #001d21; font-size: 0.75rem; font-weight: 500;">Aa</span>
      </div>
      <div class="swatch-info">
        <div class="swatch-name">Accent Purple</div>
        <div class="swatch-value">#9b99ff · rgb(155, 153, 255)</div>
        <div class="swatch-token">--color-accent</div>
      </div>
    </div>
    <div class="swatch">
      <div class="swatch-color" style="background-color: #7370ff;">
        <span style="color: #001d21; font-size: 0.75rem; font-weight: 500;">Aa</span>
      </div>
      <div class="swatch-info">
        <div class="swatch-name">Accent Hover</div>
        <div class="swatch-value">#7370ff · rgb(115, 112, 255)</div>
        <div class="swatch-token">--color-accent-hover</div>
      </div>
    </div>
    <div class="swatch">
      <div class="swatch-color" style="background-color: #001d21;">
        <span style="color: #fff; font-size: 0.75rem; font-weight: 500;">Aa</span>
      </div>
      <div class="swatch-info">
        <div class="swatch-name">Dark Teal</div>
        <div class="swatch-value">#001d21 · rgb(0, 29, 33)</div>
        <div class="swatch-token">--color-bg-primary</div>
      </div>
    </div>
    <div class="swatch">
      <div class="swatch-color" style="background-color: #002328;">
        <span style="color: #fff; font-size: 0.75rem; font-weight: 500;">Aa</span>
      </div>
      <div class="swatch-info">
        <div class="swatch-name">Dark Teal Light</div>
        <div class="swatch-value">#002328 · rgb(0, 35, 40)</div>
        <div class="swatch-token">--color-bg-secondary</div>
      </div>
    </div>
  </div>

  <h2>{t("colors.neutral.title")}</h2>
  <div class="swatch-grid">
    <div class="swatch">
      <div class="swatch-color" style="background-color: #ffffff; border-bottom: 1px solid var(--color-border-primary);">
        <span style="color: #001d21; font-size: 0.75rem; font-weight: 500;">Aa</span>
      </div>
      <div class="swatch-info">
        <div class="swatch-name">White</div>
        <div class="swatch-value">#ffffff</div>
        <div class="swatch-token">--color-text-primary / --color-bg-inverse</div>
      </div>
    </div>
    <div class="swatch">
      <div class="swatch-color" style="background-color: #001d21;">
        <span style="color: rgba(255,255,255,0.6); font-size: 0.75rem; font-weight: 500;">Aa</span>
      </div>
      <div class="swatch-info">
        <div class="swatch-name">White 60%</div>
        <div class="swatch-value">rgba(255, 255, 255, 0.6)</div>
        <div class="swatch-token">--color-text-secondary</div>
      </div>
    </div>
    <div class="swatch">
      <div class="swatch-color" style="background-color: #fff;">
        <span style="color: #001d21; font-size: 0.75rem; font-weight: 500;">Aa</span>
      </div>
      <div class="swatch-info">
        <div class="swatch-name">Dark Teal (on white)</div>
        <div class="swatch-value">#001d21</div>
        <div class="swatch-token">--color-text-inverse</div>
      </div>
    </div>
  </div>

  <h2>{t("colors.modes.title")}</h2>
  <p>{t("colors.modes.desc")}</p>

  <div class="mode-preview-grid">
    <div class="mode-preview mode-preview--dark">
      <div class="mode-preview-header">
        <h4>{t("colors.dark.title")}</h4>
      </div>
      <div class="mode-preview-body" style="background-color: #001d21; color: #fff;">
        <p class="mode-sample-heading" style="font-family: var(--font-heading); font-weight: 500; font-size: 1.33rem; margin-bottom: 0.5em;">Pantalytics</p>
        <p class="mode-sample-body" style="color: rgba(255,255,255,0.6); font-size: 0.88rem; margin-bottom: 1em;">Smart business software that brings order to your processes.</p>
        <span class="mode-sample-btn" style="background-color: #9b99ff; color: #001d21; padding: 0.5em 1em; border-radius: 0.25rem; font-size: 0.81rem; font-weight: 500;">Accent button</span>
      </div>
    </div>
    <div class="mode-preview mode-preview--light">
      <div class="mode-preview-header">
        <h4>{t("colors.light.title")}</h4>
      </div>
      <div class="mode-preview-body" style="background-color: #ffffff; color: #001d21;">
        <p class="mode-sample-heading" style="font-family: var(--font-heading); font-weight: 500; font-size: 1.33rem; margin-bottom: 0.5em;">Pantalytics</p>
        <p class="mode-sample-body" style="color: rgba(0,29,33,0.6); font-size: 0.88rem; margin-bottom: 1em;">Smart business software that brings order to your processes.</p>
        <span class="mode-sample-btn" style="background-color: #5b58d8; color: #fff; padding: 0.5em 1em; border-radius: 0.25rem; font-size: 0.81rem; font-weight: 500;">Accent button</span>
      </div>
    </div>
  </div>

  <h3>{t("colors.dark.title")}</h3>
  <p>{t("colors.dark.desc")}</p>
  <div class="swatch-grid">
    <div class="swatch">
      <div class="swatch-color" style="background-color: #9b99ff;">
        <span style="color: #001d21; font-size: 0.75rem; font-weight: 500;">Aa</span>
      </div>
      <div class="swatch-info">
        <div class="swatch-name">Accent</div>
        <div class="swatch-value">#9b99ff</div>
        <div class="swatch-token">--color-accent</div>
      </div>
    </div>
    <div class="swatch">
      <div class="swatch-color" style="background-color: #7370ff;">
        <span style="color: #001d21; font-size: 0.75rem; font-weight: 500;">Aa</span>
      </div>
      <div class="swatch-info">
        <div class="swatch-name">Accent Hover</div>
        <div class="swatch-value">#7370ff</div>
        <div class="swatch-token">--color-accent-hover</div>
      </div>
    </div>
    <div class="swatch">
      <div class="swatch-color" style="background-color: #001d21;">
        <span style="color: #fff; font-size: 0.75rem; font-weight: 500;">Aa</span>
      </div>
      <div class="swatch-info">
        <div class="swatch-name">BG Primary</div>
        <div class="swatch-value">#001d21</div>
        <div class="swatch-token">--color-bg-primary</div>
      </div>
    </div>
    <div class="swatch">
      <div class="swatch-color" style="background-color: #002328;">
        <span style="color: #fff; font-size: 0.75rem; font-weight: 500;">Aa</span>
      </div>
      <div class="swatch-info">
        <div class="swatch-name">BG Secondary</div>
        <div class="swatch-value">#002328</div>
        <div class="swatch-token">--color-bg-secondary</div>
      </div>
    </div>
    <div class="swatch">
      <div class="swatch-color" style="background-color: #001d21;">
        <span style="color: #fff; font-size: 0.75rem; font-weight: 500;">Aa</span>
      </div>
      <div class="swatch-info">
        <div class="swatch-name">Text Primary</div>
        <div class="swatch-value">#ffffff</div>
        <div class="swatch-token">--color-text-primary</div>
      </div>
    </div>
    <div class="swatch">
      <div class="swatch-color" style="background-color: #001d21;">
        <span style="color: rgba(255,255,255,0.6); font-size: 0.75rem; font-weight: 500;">Aa</span>
      </div>
      <div class="swatch-info">
        <div class="swatch-name">Text Secondary</div>
        <div class="swatch-value">rgba(255,255,255,0.6)</div>
        <div class="swatch-token">--color-text-secondary</div>
      </div>
    </div>
  </div>

  <h3>{t("colors.light.title")}</h3>
  <p>{t("colors.light.desc")}</p>
  <div class="swatch-grid">
    <div class="swatch swatch--light">
      <div class="swatch-color" style="background-color: #5b58d8;">
        <span style="color: #fff; font-size: 0.75rem; font-weight: 500;">Aa</span>
      </div>
      <div class="swatch-info" style="background-color: #f4f5f7; color: #001d21;">
        <div class="swatch-name" style="color: #001d21;">Accent</div>
        <div class="swatch-value" style="color: rgba(0,29,33,0.6);">#5b58d8</div>
        <div class="swatch-token" style="color: rgba(0,29,33,0.5);">--color-light-accent</div>
      </div>
    </div>
    <div class="swatch swatch--light">
      <div class="swatch-color" style="background-color: #4a47c4;">
        <span style="color: #fff; font-size: 0.75rem; font-weight: 500;">Aa</span>
      </div>
      <div class="swatch-info" style="background-color: #f4f5f7; color: #001d21;">
        <div class="swatch-name" style="color: #001d21;">Accent Hover</div>
        <div class="swatch-value" style="color: rgba(0,29,33,0.6);">#4a47c4</div>
        <div class="swatch-token" style="color: rgba(0,29,33,0.5);">--color-light-accent-hover</div>
      </div>
    </div>
    <div class="swatch swatch--light">
      <div class="swatch-color" style="background-color: #ffffff; border-bottom: 1px solid rgba(0,29,33,0.1);">
        <span style="color: #001d21; font-size: 0.75rem; font-weight: 500;">Aa</span>
      </div>
      <div class="swatch-info" style="background-color: #f4f5f7; color: #001d21;">
        <div class="swatch-name" style="color: #001d21;">BG Primary</div>
        <div class="swatch-value" style="color: rgba(0,29,33,0.6);">#ffffff</div>
        <div class="swatch-token" style="color: rgba(0,29,33,0.5);">--color-light-bg-primary</div>
      </div>
    </div>
    <div class="swatch swatch--light">
      <div class="swatch-color" style="background-color: #f4f5f7;">
        <span style="color: #001d21; font-size: 0.75rem; font-weight: 500;">Aa</span>
      </div>
      <div class="swatch-info" style="background-color: #f4f5f7; color: #001d21;">
        <div class="swatch-name" style="color: #001d21;">BG Secondary</div>
        <div class="swatch-value" style="color: rgba(0,29,33,0.6);">#f4f5f7</div>
        <div class="swatch-token" style="color: rgba(0,29,33,0.5);">--color-light-bg-secondary</div>
      </div>
    </div>
    <div class="swatch swatch--light">
      <div class="swatch-color" style="background-color: #fff;">
        <span style="color: #001d21; font-size: 0.75rem; font-weight: 500;">Aa</span>
      </div>
      <div class="swatch-info" style="background-color: #f4f5f7; color: #001d21;">
        <div class="swatch-name" style="color: #001d21;">Text Primary</div>
        <div class="swatch-value" style="color: rgba(0,29,33,0.6);">#001d21</div>
        <div class="swatch-token" style="color: rgba(0,29,33,0.5);">--color-light-text-primary</div>
      </div>
    </div>
    <div class="swatch swatch--light">
      <div class="swatch-color" style="background-color: #fff;">
        <span style="color: rgba(0,29,33,0.6); font-size: 0.75rem; font-weight: 500;">Aa</span>
      </div>
      <div class="swatch-info" style="background-color: #f4f5f7; color: #001d21;">
        <div class="swatch-name" style="color: #001d21;">Text Secondary</div>
        <div class="swatch-value" style="color: rgba(0,29,33,0.6);">rgba(0,29,33,0.6)</div>
        <div class="swatch-token" style="color: rgba(0,29,33,0.5);">--color-light-text-secondary</div>
      </div>
    </div>
  </div>

  <h2>{t("colors.contrast.title")}</h2>
  <p>{t("colors.contrast.desc")}</p>
  <table class="contrast-table">
    <thead>
      <tr>
        <th>{t("colors.contrast.combination")}</th>
        <th>{t("colors.contrast.ratio")}</th>
        <th>{t("colors.contrast.aa")}</th>
        <th>{t("colors.contrast.aaa")}</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>#ffffff on #001d21</td>
        <td>17.65:1</td>
        <td class="contrast-pass">Pass</td>
        <td class="contrast-pass">Pass</td>
      </tr>
      <tr>
        <td>rgba(255,255,255,0.6) on #001d21</td>
        <td>7.06:1</td>
        <td class="contrast-pass">Pass</td>
        <td class="contrast-pass">Pass (large)</td>
      </tr>
      <tr>
        <td>#9b99ff on #001d21</td>
        <td>5.84:1</td>
        <td class="contrast-pass">Pass</td>
        <td class="contrast-pass">Pass (large)</td>
      </tr>
      <tr>
        <td>#001d21 on #ffffff</td>
        <td>17.65:1</td>
        <td class="contrast-pass">Pass</td>
        <td class="contrast-pass">Pass</td>
      </tr>
      <tr>
        <td>#9b99ff on #ffffff</td>
        <td>3.02:1</td>
        <td class="contrast-fail">Fail (normal)</td>
        <td class="contrast-fail">Fail</td>
      </tr>
    </tbody>
  </table>

  <h2>{t("colors.contrast.light.title")}</h2>
  <p>{t("colors.contrast.light.desc")}</p>
  <table class="contrast-table">
    <thead>
      <tr>
        <th>{t("colors.contrast.combination")}</th>
        <th>{t("colors.contrast.ratio")}</th>
        <th>{t("colors.contrast.aa")}</th>
        <th>{t("colors.contrast.aaa")}</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>#001d21 on #ffffff</td>
        <td>17.65:1</td>
        <td class="contrast-pass">Pass</td>
        <td class="contrast-pass">Pass</td>
      </tr>
      <tr>
        <td>rgba(0,29,33,0.6) on #ffffff</td>
        <td>7.06:1</td>
        <td class="contrast-pass">Pass</td>
        <td class="contrast-pass">Pass (large)</td>
      </tr>
      <tr>
        <td>#5b58d8 on #ffffff</td>
        <td>5.20:1</td>
        <td class="contrast-pass">Pass</td>
        <td class="contrast-pass">Pass (large)</td>
      </tr>
      <tr>
        <td>#4a47c4 on #ffffff</td>
        <td>6.36:1</td>
        <td class="contrast-pass">Pass</td>
        <td class="contrast-pass">Pass (large)</td>
      </tr>
      <tr>
        <td>#5b58d8 on #f4f5f7</td>
        <td>4.82:1</td>
        <td class="contrast-pass">Pass</td>
        <td class="contrast-pass">Pass (large)</td>
      </tr>
    </tbody>
  </table>

  <h2>{t("colors.guidelines.title")}</h2>
  <ul class="guidelines-list">
    <li>{t("colors.guideline.1")}</li>
    <li>{t("colors.guideline.2")}</li>
    <li>{t("colors.guideline.3")}</li>
    <li>{t("colors.guideline.4")}</li>
  </ul>
</BrandLayout>

<style>
  .mode-preview-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
    margin-block: var(--space-md);
  }

  .mode-preview {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border-primary);
  }

  .mode-preview-header {
    padding: var(--space-xs) var(--space-sm);
    background-color: var(--color-bg-secondary);
  }

  .mode-preview-header h4 {
    font-size: 0.81rem;
    margin-bottom: 0;
    color: var(--color-text-secondary);
  }

  .mode-preview-body {
    padding: var(--space-md);
  }

  .mode-sample-btn {
    display: inline-block;
  }

  @media (max-width: 767px) {
    .mode-preview-grid {
      grid-template-columns: 1fr;
    }
  }

  .guidelines-list {
    list-style: none;
    margin-top: var(--space-sm);
  }

  .guidelines-list li {
    font-size: 0.88rem;
    color: var(--color-text-secondary);
    padding: 0.5em 0;
    padding-left: 1.5em;
    position: relative;
  }

  .guidelines-list li::before {
    content: "\2022";
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }
</style>
