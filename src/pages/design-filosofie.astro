---
import BrandLayout from "@/layouts/BrandLayout.astro";
import { useTranslations } from "@/i18n/utils";

const t = useTranslations("nl");

const principles = [
  { key: "disclosure", icon: "◐" },
  { key: "simplicity", icon: "◻" },
  { key: "odoo", icon: "⚙" },
  { key: "accessible", icon: "◉" },
  { key: "content", icon: "▤" },
];

const socialFormats = [
  { format: "LinkedIn post", dimensions: "1200 × 1200", usage: "Quote, statistiek, aankondiging" },
  { format: "LinkedIn carousel", dimensions: "1080 × 1350", usage: "Slides, tips, uitleg" },
  { format: "Instagram / Story", dimensions: "1080 × 1920", usage: "Verticale content" },
];

const videoFormats = [
  { format: "YouTube thumbnail", dimensions: "1280 × 720", usage: "Video-voorvertoning" },
  { format: "Video intro", dimensions: "1920 × 1080", usage: "Logo reveal, ~3 seconden" },
  { format: "Video outro", dimensions: "1920 × 1080", usage: "CTA + logo, ~5 seconden" },
  { format: "Lower third", dimensions: "1920 × 200", usage: "Naam + functietitel overlay" },
];

const blogFormats = [
  { format: "Blog hero", dimensions: "1920 × 1080", usage: "Artikelkop (Directus)" },
  { format: "OG image", dimensions: "1200 × 630", usage: "Social sharing preview" },
  { format: "Favicon", dimensions: "32 × 32 / SVG", usage: "Browsertab" },
];
---

<BrandLayout title={t("design.title")} lang="nl" description={t("design.intro")} activeSection="design">
  <h1>{t("design.h1")}</h1>
  <p class="brand-intro">{t("design.intro")}</p>

  <h2>{t("design.principles.title")}</h2>
  <div class="principles-grid">
    {principles.map((p) => (
      <div class="principle-card">
        <div class="principle-icon">{p.icon}</div>
        <h3>{t(`design.principle.${p.key}.title`)}</h3>
        <p>{t(`design.principle.${p.key}.desc`)}</p>
        <div class="principle-example">
          <span class="principle-example-label">Voorbeeld</span>
          {t(`design.principle.${p.key}.example`)}
        </div>
      </div>
    ))}
  </div>

  <h2>{t("design.visual.title")}</h2>
  <p class="brand-intro">{t("design.visual.desc")}</p>

  <h3>{t("design.visual.vision.title")}</h3>
  <p>{t("design.visual.vision.desc")}</p>

  <h3>{t("design.visual.style.title")}</h3>
  <p>{t("design.visual.style.desc")}</p>

  <h3>{t("design.visual.principles.title")}</h3>
  <div class="data-metaphors">
    <div class="data-metaphor"><span class="metaphor-arrow">1</span>{t("design.visual.principle.1")}</div>
    <div class="data-metaphor"><span class="metaphor-arrow">2</span>{t("design.visual.principle.2")}</div>
    <div class="data-metaphor"><span class="metaphor-arrow">3</span>{t("design.visual.principle.3")}</div>
    <div class="data-metaphor"><span class="metaphor-arrow">4</span>{t("design.visual.principle.4")}</div>
    <div class="data-metaphor"><span class="metaphor-arrow">5</span>{t("design.visual.principle.5")}</div>
    <div class="data-metaphor"><span class="metaphor-arrow">6</span>{t("design.visual.principle.6")}</div>
  </div>

  <h3>{t("design.visual.materials.title")}</h3>
  <p>{t("design.visual.materials.desc")}</p>
  <div class="material-grid">
    <div class="material-card">
      <div class="material-swatch" style="background: linear-gradient(145deg, #b8b5b0 0%, #a8a5a0 50%, #c2bfba 100%);"></div>
      <p>Beton</p>
    </div>
    <div class="material-card">
      <div class="material-swatch" style="background: linear-gradient(145deg, #1a5c2a 0%, #2d7a3e 50%, #1a5c2a 100%);"></div>
      <p>PCB</p>
    </div>
    <div class="material-card">
      <div class="material-swatch" style="background: linear-gradient(145deg, #d4b896 0%, #c4a87a 50%, #dcc8a6 100%);"></div>
      <p>Eikenhout</p>
    </div>
    <div class="material-card">
      <div class="material-swatch" style="background: linear-gradient(145deg, #d4a853 0%, #c49a3e 50%, #e0b96a 100%);"></div>
      <p>Messing</p>
    </div>
    <div class="material-card">
      <div class="material-swatch" style="background: linear-gradient(145deg, #b87a5a 0%, #c4876a 50%, #a86d4e 100%);"></div>
      <p>Koper</p>
    </div>
    <div class="material-card">
      <div class="material-swatch" style="background: #f5f2ed; border: 1px dashed var(--color-border-secondary);"></div>
      <p>Ruitjespapier</p>
    </div>
    <div class="material-card">
      <div class="material-swatch material-swatch--accent"></div>
      <p>Aquarel</p>
    </div>
    <div class="material-card">
      <div class="material-swatch" style="background: linear-gradient(145deg, #2a2a2a 0%, #3a3a3a 50%, #222 100%);"></div>
      <p>Zwart staal</p>
    </div>
  </div>

  <h3>{t("design.visual.compositions.title")}</h3>
  <div class="refs-grid">
    <div class="ref-card">
      <h4>Exploded view</h4>
      <p>{t("design.visual.comp.1")}</p>
    </div>
    <div class="ref-card">
      <h4>Materiaalgrid</h4>
      <p>{t("design.visual.comp.2")}</p>
    </div>
    <div class="ref-card">
      <h4>Header strip</h4>
      <p>{t("design.visual.comp.3")}</p>
    </div>
    <div class="ref-card">
      <h4>Close-up detail</h4>
      <p>{t("design.visual.comp.4")}</p>
    </div>
  </div>

  <h3>{t("design.visual.color.title")}</h3>
  <p>{t("design.visual.color.desc")}</p>

  <h3>{t("design.visual.tone.title")}</h3>
  <p>{t("design.visual.tone.desc")}</p>

  <h3>{t("design.visual.donts.title")}</h3>
  <div class="donts-list" style="margin-block: var(--space-md);">
    <h4>{t("design.visual.donts.title")}</h4>
    <ul>
      <li>{t("design.visual.dont.1")}</li>
      <li>{t("design.visual.dont.2")}</li>
      <li>{t("design.visual.dont.3")}</li>
      <li>{t("design.visual.dont.4")}</li>
      <li>{t("design.visual.dont.5")}</li>
    </ul>
  </div>

  <h2>{t("design.systemprompt.title")}</h2>
  <p>{t("design.systemprompt.desc")}</p>
  <div class="prompt-library">
    <div class="prompt-card prompt-card--system">
      <h4>Pantalytics Brand System Prompt</h4>
      <pre><code>Je maakt content voor Pantalytics, een Europees AI- en ERP-bedrijf uit Utrecht.

VISIE: Technologie moet mensen bevrijden, niet belasten. AI en automatisering zorgen ervoor dat mensen kunnen doen wat hen gelukkig maakt: buiten zijn, sociale verbinding, natuur, muziek, kunst, bewegen. Technologie is de enabler, niet het onderwerp.

MISSIE: Orde brengen in bedrijfsprocessen met veilige, open source software en AI. We versterken teams, niet vervangen. Europees gehost, GDPR-compliant, geen vendor lock-in.

MERKWAARDEN: Betrouwbaar, Open, Praktisch, Slim.

SCHRIJFSTIJL (McKinsey Pyramid Principle):
- Begin altijd met de conclusie
- Onderbouw met 2-5 argumenten (MECE)
- Elk punt moet de "so what?"-test overleven
- Slide/alineatitels zijn volledige zinnen met het inzicht, geen onderwerplabels
- Toon: professioneel, warm, eerlijk. Eerste persoon meervoud ("wij"). Directe aanspreking ("je").
- Gebruik actieve stem, wees specifiek, vermijd jargon.

CHARTS & DATA (Economist-stijl):
- Conclusie in de charttitel (volledige zin)
- Labels direct in de grafiek, geen aparte legenda
- Eén highlightkleur op een grijze basis
- Minimale decoratie, geen 3D, bronvermelding altijd

VISUELE STIJL (Isometrische Materialiteit):
- Isometrische composities van gestapelde materiaallagen op witte achtergrond
- Materialen: beton, printplaat (PCB), eikenhout, messing, koper, ruitjespapier, aquarel, linnen, zwart staal
- Technologie als laag: PCB met paarse traces, koperen circuits
- Ambacht zichtbaar: zwaluwstaartverbindingen, hexbouten, klinknagels, messing schroeven
- Blueprint + aquarel samen: technische tekeningen naast zachte waterverf
- Compositietypes: exploded view, materiaalgrid, header strip, close-up detail
- Vermijd: flat vector illustraties, stockfoto's, plastiek 3D, niet-isometrische perspectieven

KLEUREN:
- Paars (#9b99ff): PCB traces, aquarelwashes, LED gloed
- Navy (#1b3a5c): blueprint inkt, technische tekeningen
- Natuurlijke kleuren domineren: groen, zonlicht-goud, hemelsblauw, zand
- Dark mode UI: bg #001d21, accent #9b99ff
- Light mode UI: bg #ffffff, accent #5b58d8

TYPOGRAFIE: Lexend 500 (koppen), Instrument Sans 400-700 (body).

Meer details: brand.pantalytics.com</code></pre>
    </div>
  </div>

  <h2>{t("design.fluxpreset.title")}</h2>
  <p>{t("design.fluxpreset.desc")}</p>
  <div class="prompt-library">
    <div class="prompt-card prompt-card--system">
      <h4>Flux Preset — kopieer voor elke prompt</h4>
      <pre><code>Isometric product photography on white background, realistic material textures, soft natural shadows, craft meets technology, purple (#9b99ff) and navy (#1b3a5c) accent colors, fine art quality, no text no letters no watermark</code></pre>
    </div>
  </div>

  <h3>{t("design.visual.prompts.title")}</h3>
  <p>{t("design.visual.prompts.desc")}</p>
  <div class="prompt-library">
    <div class="prompt-card">
      <h4>Exploded view — hero visual</h4>
      <pre><code>Isometric exploded view on white background, six diamond layers floating with spacing between, bottom to top: raw concrete base with steel bolts, green PCB circuit board with purple (#9b99ff) glowing traces, brushed brass plate with hex screws, oak wood with navy (#1b3a5c) blueprint drawing, cream graph paper with technical schematic, torn handmade paper with soft purple watercolor wash. Brass nuts and washers between layers, realistic textures, fine art product photography</code></pre>
    </div>
    <div class="prompt-card">
      <h4>Materiaalgrid — social media</h4>
      <pre><code>Isometric diamond tiles on white background arranged in formation, each tile a different material with data visualization: copper tile with etched network diagram, concrete tile with purple (#9b99ff) watercolor bar chart, oak tile with navy (#1b3a5c) ink blueprint, black steel tile with engraved line graph, graph paper tile with hand-drawn flowchart, brass tile with data nodes. Realistic textures, soft shadows</code></pre>
    </div>
    <div class="prompt-card">
      <h4>Header strip — website banner</h4>
      <pre><code>Wide isometric composition on white background, overlapping diamond material tiles from left to right: dark steel with white blueprint lines, raw concrete with purple (#9b99ff) watercolor stain, polished brass with hex bolts, green PCB with purple traces, oak wood with navy ink drawing, torn paper with purple wash. Generous white space above, realistic textures, fine art photography</code></pre>
    </div>
    <div class="prompt-card">
      <h4>Close-up detail — achtergrond</h4>
      <pre><code>Close-up isometric view of layered materials, raw concrete slab with purple (#9b99ff) watercolor bleeding onto its edge, green PCB partially visible underneath with purple traces, brass hex bolts and washers scattered, soft natural shadows, minimal and elegant, white background</code></pre>
    </div>
    <div class="prompt-card">
      <h4>Exploded view — met printplaat focus</h4>
      <pre><code>Isometric exploded view on white background, four layers: heavy concrete base with anchor bolts, green PCB with purple (#9b99ff) LED traces glowing and copper components, brushed copper sheet with precision hex bolt pattern, torn watercolor paper with soft purple data scatter plot. Stainless steel fasteners between layers, engineering teardown aesthetic, realistic textures</code></pre>
    </div>
    <div class="prompt-card">
      <h4>Materialen + data — vierkant</h4>
      <pre><code>Isometric diamond tiles on white background, four tiles in 2x2: concrete with purple (#9b99ff) watercolor bar chart painted on surface, oak wood with navy (#1b3a5c) network diagram in ink, copper with patina and engraved data nodes, graph paper with precise flowchart drawing. Hex nuts visible between tiles, where data meets craft, realistic textures, square format</code></pre>
    </div>
  </div>

  <h2>{t("design.photography.title")}</h2>
  <p>{t("design.photography.desc")}</p>

  <div class="dos-donts">
    <div class="dos-list">
      <h4>{t("design.photography.prefer.title")}</h4>
      <ul>
        <li>{t("design.photography.prefer.1")}</li>
        <li>{t("design.photography.prefer.2")}</li>
        <li>{t("design.photography.prefer.3")}</li>
        <li>{t("design.photography.prefer.4")}</li>
      </ul>
    </div>
    <div class="donts-list">
      <h4>{t("design.photography.avoid.title")}</h4>
      <ul>
        <li>{t("design.photography.avoid.1")}</li>
        <li>{t("design.photography.avoid.2")}</li>
        <li>{t("design.photography.avoid.3")}</li>
        <li>{t("design.photography.avoid.4")}</li>
      </ul>
    </div>
  </div>

  <h3>{t("design.photography.treatment.title")}</h3>
  <p>{t("design.photography.treatment.desc")}</p>

  <h2>{t("design.charts.title")}</h2>
  <p>{t("design.charts.desc")}</p>

  <div class="chart-rules">
    <div class="chart-rule">
      <h4>{t("design.charts.rule.1.title")}</h4>
      <p>{t("design.charts.rule.1.desc")}</p>
      <div class="chart-example">
        <div class="chart-example-bad">
          <span class="chart-example-label bad">Niet</span>
          <span class="chart-example-title">{t("design.charts.rule.1.bad")}</span>
        </div>
        <div class="chart-example-good">
          <span class="chart-example-label good">Wel</span>
          <span class="chart-example-title">{t("design.charts.rule.1.good")}</span>
        </div>
      </div>
    </div>
    <div class="chart-rule">
      <h4>{t("design.charts.rule.2.title")}</h4>
      <p>{t("design.charts.rule.2.desc")}</p>
    </div>
    <div class="chart-rule">
      <h4>{t("design.charts.rule.3.title")}</h4>
      <p>{t("design.charts.rule.3.desc")}</p>
      <div class="color-strip">
        <span class="color-dot" style="background-color: #6b7280;"></span>
        <span class="color-dot" style="background-color: #9ca3af;"></span>
        <span class="color-dot" style="background-color: #d1d5db;"></span>
        <span class="color-dot color-dot--accent" style="background-color: #9b99ff;"></span>
      </div>
    </div>
    <div class="chart-rule">
      <h4>{t("design.charts.rule.4.title")}</h4>
      <p>{t("design.charts.rule.4.desc")}</p>
    </div>
    <div class="chart-rule">
      <h4>{t("design.charts.rule.5.title")}</h4>
      <p>{t("design.charts.rule.5.desc")}</p>
    </div>
    <div class="chart-rule">
      <h4>{t("design.charts.rule.6.title")}</h4>
      <p>{t("design.charts.rule.6.desc")}</p>
    </div>
  </div>

  <h2>{t("design.templates.title")}</h2>
  <p>{t("design.templates.desc")}</p>

  <h3>{t("design.templates.social.title")}</h3>
  <table class="format-table">
    <thead>
      <tr>
        <th>{t("design.templates.format")}</th>
        <th>{t("design.templates.dimensions")}</th>
        <th>{t("design.templates.usage")}</th>
      </tr>
    </thead>
    <tbody>
      {socialFormats.map((f) => (
        <tr>
          <td>{f.format}</td>
          <td>{f.dimensions}</td>
          <td>{f.usage}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h3>{t("design.templates.video.title")}</h3>
  <table class="format-table">
    <thead>
      <tr>
        <th>{t("design.templates.format")}</th>
        <th>{t("design.templates.dimensions")}</th>
        <th>{t("design.templates.usage")}</th>
      </tr>
    </thead>
    <tbody>
      {videoFormats.map((f) => (
        <tr>
          <td>{f.format}</td>
          <td>{f.dimensions}</td>
          <td>{f.usage}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h3>{t("design.templates.blog.title")}</h3>
  <table class="format-table">
    <thead>
      <tr>
        <th>{t("design.templates.format")}</th>
        <th>{t("design.templates.dimensions")}</th>
        <th>{t("design.templates.usage")}</th>
      </tr>
    </thead>
    <tbody>
      {blogFormats.map((f) => (
        <tr>
          <td>{f.format}</td>
          <td>{f.dimensions}</td>
          <td>{f.usage}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2>Brand Pattern</h2>
  <p>Het Pantalytics-netwerkpatroon kan worden gebruikt als achtergrond voor video's, social media posts, presentaties en blog hero images. Beschikbaar in dark en light varianten.</p>
  <div class="pattern-demo">
    <div class="pattern-box pattern-box--dark">
      <span class="pattern-label">Dark</span>
    </div>
    <div class="pattern-box pattern-box--light">
      <span class="pattern-label">Light</span>
    </div>
  </div>
</BrandLayout>

<style>
  /* Material palette */
  .material-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: var(--space-sm);
    margin-block: var(--space-md);
  }

  .material-card {
    text-align: center;
  }

  .material-swatch {
    height: 80px;
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-xs);
    border: 1px solid var(--color-border-primary);
  }

  .material-swatch--concrete {
    background: linear-gradient(145deg, #b8b5b0 0%, #a8a5a0 50%, #c2bfba 100%);
  }

  .material-swatch--wood {
    background: linear-gradient(145deg, #d4b896 0%, #c4a87a 30%, #dcc8a6 70%, #c9ad85 100%);
  }

  .material-swatch--accent {
    background-color: #9b99ff;
  }

  .material-swatch--light {
    background: linear-gradient(180deg, #faf8f5 0%, #f5f0ea 100%);
  }

  .material-swatch--space {
    background-color: #ffffff;
    border-style: dashed;
  }

  .material-card p {
    font-size: 0.81rem;
    color: var(--color-text-secondary);
    margin-bottom: 0;
  }

  /* Data metaphors */
  .data-metaphors {
    margin-block: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .data-metaphor {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-xs) var(--space-sm);
    background-color: var(--color-bg-secondary);
    border-radius: var(--radius-sm);
    font-size: 0.88rem;
    color: var(--color-text-secondary);
  }

  .metaphor-arrow {
    color: var(--color-accent);
    font-weight: var(--font-weight-bold);
    flex-shrink: 0;
  }

  /* Reference cards */
  .refs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
    margin-block: var(--space-md);
  }

  .ref-card {
    padding: var(--space-sm);
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border-primary);
    border-radius: var(--radius-md);
  }

  .ref-card h4 {
    font-size: 0.88rem;
    color: var(--color-accent);
    margin-bottom: 0.25rem;
  }

  .ref-card p {
    font-size: 0.81rem;
    color: var(--color-text-secondary);
    margin-bottom: 0;
  }

  /* Prompt library */
  .prompt-library {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-block: var(--space-md);
  }

  .prompt-card {
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border-primary);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .prompt-card h4 {
    font-size: 0.81rem;
    padding: var(--space-xs) var(--space-sm);
    margin-bottom: 0;
    border-bottom: 1px solid var(--color-border-primary);
    color: var(--color-text-primary);
  }

  .prompt-card pre {
    margin: 0;
    padding: var(--space-sm);
    overflow-x: auto;
  }

  .prompt-card code {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    white-space: pre-wrap;
    word-break: break-word;
    line-height: 1.5;
  }

  .prompt-card--system {
    border-color: rgba(155, 153, 255, 0.3);
    background-color: rgba(155, 153, 255, 0.05);
  }

  .prompt-card--system h4 {
    color: var(--color-accent);
    border-bottom-color: rgba(155, 153, 255, 0.2);
  }

  .principles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-sm);
    margin-block: var(--space-md);
  }

  .principle-card {
    padding: var(--space-md);
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border-primary);
    border-radius: var(--radius-lg);
  }

  .principle-icon {
    font-size: 1.5rem;
    margin-bottom: var(--space-xs);
    color: var(--color-accent);
  }

  .principle-card h3 {
    font-size: 1.15rem;
    margin-top: 0;
    margin-bottom: var(--space-xs);
  }

  .principle-card p {
    font-size: 0.88rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-sm);
  }

  .principle-example {
    font-size: 0.81rem;
    color: var(--color-text-secondary);
    padding: var(--space-xs) var(--space-sm);
    background-color: rgba(155, 153, 255, 0.05);
    border-left: 2px solid var(--color-accent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .principle-example-label {
    display: block;
    font-size: 0.69rem;
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin-bottom: 0.25em;
  }

  .treatment-demo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
    margin-block: var(--space-md);
  }

  .treatment-box {
    height: 160px;
    border-radius: var(--radius-lg);
    display: flex;
    align-items: flex-end;
    padding: var(--space-xs);
    position: relative;
    background: linear-gradient(135deg, #667788 0%, #8899aa 50%, #556677 100%);
  }

  .treatment-box--treated {
    overflow: hidden;
  }

  .treatment-overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 29, 33, 0.15);
  }

  .treatment-label {
    font-size: 0.69rem;
